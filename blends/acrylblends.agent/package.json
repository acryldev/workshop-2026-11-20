{
  "name": "agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#acryl-jsx/jsx-runtime": "./plugins/acryl-router/src/core/jsx/jsx-runtime.ts",
    "#acryl-jsx/jsx-dev-runtime": "./plugins/acryl-router/src/core/jsx/jsx-dev-runtime.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node --import ./plugins/acryl-node-server/src/register.ts src/main.ts",
    "dev": "node --watch --import ./plugins/acryl-node-server/src/register.ts src/main.ts",
    "test": "node --import ./plugins/acryl-node-server/src/register.ts --test \"test/**/*.test.{ts,tsx}\"",
    "check": "tsc --noEmit",
    "lock": "node plugins/manifest/lock.ts",
    "save": "node plugins/save/cli.ts",
    "upgrade": "node plugins/manifest/upgrade-cli.ts",
    "predev": "node scripts/check-node.cjs",
    "prestart": "node scripts/check-node.cjs",
    "pretest": "node scripts/check-node.cjs",
    "precheck": "node scripts/check-node.cjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@webboxes/app-persistence": "0.1.1",
    "@webboxes/blends-core": "0.4.0",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
